---
import { SITE_NAME } from '../games';
interface Props { title?: string; description?: string; image?: string }
const { title, description = 'A free, hand-curated catalog of indie browser games that showed up on Reddit and elsewhere, with credit to every developer.', image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
const current = canonical.pathname;
const nav = [['/', 'Catalog'], ['/library', 'My library'], ['/about', 'About']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1b1631" />
    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/">{SITE_NAME}</a>
      <nav>
        {nav.map(([href, label]) => (
          <a href={href} aria-current={current === href ? 'page' : undefined}>
            {label}{href === '/library' && <span class="count" data-lib-count></span>}
          </a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      Free, no ads, no login, no cookies. Every game belongs to its developer; “Play” opens their site.
      <a href="/about">Add or remove a game</a>
    </footer>
    <script is:inline>
      // Library = list of game ids. localStorage is the working copy; with a secret key it is also
      // synced to /api/library/<key> so the same link opens it on any device. Works offline/without storage.
      (() => {
        const KEY = 'library', LINK = 'libraryKey', DIRTY = 'libraryDirty';
        const get = (k) => { try { return localStorage.getItem(k); } catch { return null; } };
        const set = (k, v) => { try { v == null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch {} };
        const read = () => { try { return JSON.parse(get(KEY)) || []; } catch { return []; } };
        const write = (ids) => set(KEY, JSON.stringify(ids));
        const newKey = () => btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(18)))).replace(/\+/g, '-').replace(/\//g, '_');
        const api = (key, ids) => fetch(`/api/library/${key}`, ids ? { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ids }) } : {})
          .then((r) => { if (!r.ok) throw new Error(r.status); return ids ? null : r.json(); });
        // Push local copy; if it fails, remember so the next visit pushes instead of pulling.
        const push = (key) => { set(DIRTY, '1'); return api(key, read()).then(() => set(DIRTY, null)).catch(() => {}); };
        const paint = () => {
          const ids = read();
          document.querySelectorAll('[data-save]').forEach((b) => {
            const on = ids.includes(b.dataset.save);
            b.setAttribute('aria-pressed', on);
            b.textContent = on ? 'Saved ✓' : 'Save';
          });
          document.querySelectorAll('[data-lib-count]').forEach((s) => (s.textContent = ids.length ? ` (${ids.length})` : ''));
          document.dispatchEvent(new CustomEvent('library', { detail: { ids, key: get(LINK) } }));
        };
        const sync = async () => {
          const linked = new URLSearchParams(location.hash.slice(1)).get('k');
          if (linked) {
            // Opened a library link: merge this device's games into it and adopt the key.
            history.replaceState(null, '', location.pathname + location.search);
            try {
              const { ids } = await api(linked);
              write([...new Set([...ids, ...read()])]);
              set(LINK, linked);
              await push(linked);
            } catch {}
          } else if (get(LINK)) {
            if (get(DIRTY)) await push(get(LINK));
            else try { write((await api(get(LINK))).ids); } catch {}
          }
          paint();
        };
        document.addEventListener('click', (e) => {
          const b = e.target.closest('[data-save]');
          if (!b) return;
          e.preventDefault();
          const ids = read(), id = b.dataset.save;
          write(ids.includes(id) ? ids.filter((x) => x !== id) : [...ids, id]);
          if (!get(LINK)) set(LINK, newKey());
          paint();
          push(get(LINK));
        });
        window.addEventListener('storage', paint);
        // After page scripts (rendered after this one) have registered their 'library' listeners.
        document.addEventListener('DOMContentLoaded', () => { paint(); sync(); });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Fonts: Bricolage Grotesque + Atkinson Hyperlegible, both SIL OFL, self-hosted (no third-party requests). */
  @font-face { font-family: Bricolage; src: url(/fonts/bricolage.woff2) format('woff2'); font-weight: 200 800; font-display: swap; }
  @font-face { font-family: Atkinson; src: url(/fonts/atkinson-400.woff2) format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: Atkinson; src: url(/fonts/atkinson-700.woff2) format('woff2'); font-weight: 700; font-display: swap; }
  /* Dark only: an arcade at night. Coin yellow = "Play". */
  :root {
    color-scheme: dark;
    --bg: #1b1631; --card: #261f44; --raise: #31295a; --text: #f4f0ff; --muted: #b3a9d6; --line: #3c3367;
    --coin: #ffd23f; --coin-text: #241a00; --link: #9ed8ff; --focus: #9ed8ff;
    --display: Bricolage, 'Arial Narrow', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.55 Atkinson, system-ui, sans-serif;
    background-image: radial-gradient(circle at 1px 1px, #ffffff0d 1px, transparent 0); background-size: 22px 22px; }
  a { color: var(--link); text-underline-offset: 3px; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  main { max-width: 1180px; margin: 0 auto; padding: 8px 16px 16px; }
  .top { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; justify-content: space-between; max-width: 1180px; margin: 0 auto; padding: 18px 16px; }
  .brand { font: 800 1.5rem/1 var(--display); letter-spacing: -.02em; text-decoration: none; color: var(--text); display: flex; align-items: center; gap: 10px; }
  .brand::before { content: ''; width: 14px; height: 22px; border-radius: 3px; background: var(--coin); box-shadow: 4px 4px 0 #ff5d8f; }
  .top nav { display: flex; gap: 6px; }
  .top nav a { color: var(--muted); text-decoration: none; padding: 6px 12px; border-radius: 999px; }
  .top nav a:hover { color: var(--text); }
  .top nav a[aria-current] { color: var(--text); background: var(--raise); }
  footer { max-width: 1180px; margin: 48px auto 0; padding: 20px 16px 32px; color: var(--muted); font-size: .875rem; border-top: 1px solid var(--line); }
  h1, h2 { font-family: var(--display); letter-spacing: -.02em; line-height: 1.05; }
  h1 { font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 800; margin: 16px 0 12px; }
  h2 { font-size: 1.5rem; font-weight: 700; margin: 32px 0 8px; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 18px; border-radius: 10px; font: 700 1rem/1.2 Atkinson, sans-serif; text-decoration: none; border: 2px solid var(--coin); background: var(--coin); color: var(--coin-text); cursor: pointer; box-shadow: 0 3px 0 #b8901a; }
  .btn:active { transform: translateY(2px); box-shadow: 0 1px 0 #b8901a; }
  .btn.ghost { background: transparent; color: var(--text); border-color: var(--line); box-shadow: none; }
  .btn.ghost[aria-pressed=true] { border-color: #ff5d8f; color: #ff9cbc; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; list-style: none; }
  .chips li { background: var(--raise); color: var(--muted); border-radius: 6px; padding: 1px 8px; font-size: .8125rem; }
  .muted { color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 20px; padding: 0; list-style: none; }
  .thumb { aspect-ratio: 16 / 9; width: 100%; object-fit: cover; display: block; border-radius: 10px; background: var(--raise); }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
