---
// Game cover: the author's image (GIFs stay animated) or a generated cartridge label.
import { Image } from 'astro:assets';
import type { Game } from '../games';
interface Props { game: Game; width: number; alt?: string }
const { game: g, width, alt = '' } = Astro.props;
// Hue per genre so the shelf reads by color; same genre = same family.
const hue = [...g.genre].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
---
{g.cover
  ? g.cover.format === 'gif'
    ? <img class="thumb" src={g.cover.src} alt={alt} width={g.cover.width} height={g.cover.height} loading="lazy" decoding="async" />
    : <Image class="thumb" src={g.cover} alt={alt} width={width} />
  : (
    <span class="thumb cart" style={`--h:${hue}`} aria-hidden="true">
      <span class="genre">{g.genreLabel}</span>
      <span class="name">{g.title}</span>
    </span>
  )}

<style>
  .cart {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; padding: 14px 16px; overflow: hidden;
    background:
      repeating-linear-gradient(90deg, #0000 0 10px, #00000026 10px 12px) top / 100% 14px no-repeat,
      linear-gradient(160deg, hsl(var(--h) 70% 58%), hsl(calc(var(--h) + 40) 65% 34%));
    color: #fff;
  }
  .cart::after { /* label sticker shine */
    content: ''; position: absolute; inset: 22px 14px auto auto; width: 34%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, #ffffff40, #fff0 70%);
  }
  .genre { font-size: .75rem; font-weight: 700; opacity: .85; }
  .name { font: 800 clamp(1.35rem, 2.4vw, 1.75rem)/.95 var(--display); letter-spacing: -.03em; text-wrap: balance; text-shadow: 0 2px 0 #0004; }
</style>
