---
import Cover from './Cover.astro';
import { isAi, searchText, type Game } from '../games';
interface Props { game: Game }
const { game: g } = Astro.props;
---
<li
  class="card"
  data-id={g.id}
  data-text={searchText(g)}
  data-genre={g.genre}
  data-mobile={g.mobile ? '1' : ''}
  data-multiplayer={g.multiplayer !== 'none' ? '1' : ''}
  data-ai={isAi(g) ? '1' : ''}
  data-needs={g.needs ? '1' : ''}
  data-noads={g.ads === false ? '1' : ''}
>
  <a href={`/games/${g.id}`} class="cover" tabindex="-1" aria-hidden="true"><Cover game={g} width={520} /></a>
  <div class="body">
    <h2><a href={`/games/${g.id}`}>{g.title}</a></h2>
    <span class="muted by">by <a href={`/dev/${g.devId}`}>{g.dev.name}</a></span>
    <ul class="chips">
      {g.cover && <li>{g.genreLabel}</li>}
      {g.mobile && <li>Mobile</li>}
      {g.multiplayer !== 'none' && <li>{g.multiplayer === 'local' ? 'Local multiplayer' : 'Online multiplayer'}</li>}
      {isAi(g) && <li>Made with AI</li>}
      {g.ads === true && <li>Has ads</li>}
      {g.needs && <li>Needs {g.needs}</li>}
    </ul>
    <div class="actions">
      <a class="btn" href={g.play_url} target="_blank" rel="noopener">Play ↗</a>
      <button class="btn ghost" type="button" data-save={g.id} aria-pressed="false">Save</button>
    </div>
  </div>
</li>

<style>
  .card { background: var(--card); border-radius: 14px; padding: 8px; display: flex; flex-direction: column; box-shadow: 0 0 0 1px var(--line); }
  .card:hover { box-shadow: 0 0 0 2px hsl(48 100% 62% / .6); }
  .cover { display: block; text-decoration: none; }
  .body { display: flex; flex-direction: column; gap: 6px; padding: 10px 8px 6px; flex: 1; }
  h2 { font-size: 1.25rem; margin: 0; }
  h2 a { color: var(--text); text-decoration: none; }
  .by { font-size: .875rem; }
  .actions { display: flex; gap: 8px; margin-top: auto; padding-top: 8px; }
  .actions .btn { padding: 7px 14px; font-size: .9375rem; }
</style>
